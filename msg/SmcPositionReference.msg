# Translational reference generated by Position SMC.
# kappa and its derivatives are expressed in the world/NED frame.
# mc_att_control uses these quantities with yaw/yawspeed
# to generate q_d, omega_rd and alpha_rd.

uint64 timestamp

float32[3] kappa
float32[3] kappa_dot
float32[3] kappa_ddot

float32 yaw
float32 yawspeed

bool valid
bool saturated
